# Copy to .env for local development. In production (Vercel/Netlify), set these
# in the dashboard instead - Vite reads them at BUILD time.
# .env is gitignored; never commit real values.

# Backend API base URL (must end in /api, always https in production)
VITE_API_URL=https://your-baso-server.onrender.com/api

# Socket.io origin (optional - derived from VITE_API_URL if omitted)
VITE_SOCKET_URL=https://your-baso-server.onrender.com

# Optional: request timeout in ms (default 45000 = 45s).
# Raise it if your free-tier backend needs longer to wake up.
# VITE_REQUEST_TIMEOUT_MS=60000
