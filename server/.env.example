PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-baso-client.vercel.app

# Firebase: Use EITHER a service account JSON file path OR individual env vars
# Option 1: Service account file (for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2: Individual env vars (for deployment platforms like Render/Railway)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----\n"

ACCESS_TOKEN_SECRET=your_jwt_access_secret_long_random_string
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_long_random_string

# Optional: Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
