# ─────────────────────────────────────────────────────────────
# BASO Server Environment Configuration (.env)
# ─────────────────────────────────────────────────────────────

# Server Port (auto-assigned on Render/Railway; default: 5000)
PORT=5000
NODE_ENV=development

# Allowed CORS origins for the React Frontend (comma-separated if multiple)
# In development: http://localhost:5173
# In production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# ─── NEON SERVERLESS POSTGRESQL ──────────────────────────────
# 1. Sign up / login at https://neon.tech
# 2. In your Neon Dashboard, click "Connection Details"
# 3. Choose "Pooled connection" and copy the URI (ensure ?sslmode=require is present)
DATABASE_URL=postgresql://user:password@ep-your-branch-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ─── JWT SECRETS ─────────────────────────────────────────────
# Generate secure random strings (e.g. node -e "console.log(crypto.randomBytes(32).toString('hex'))")
ACCESS_TOKEN_SECRET=baso_jwt_access_secret_super_secure_key_2026
REFRESH_TOKEN_SECRET=baso_jwt_refresh_secret_super_secure_key_2026

# ─── TWILIO SMS (REAL OTP DELIVERY) ──────────────────────────
# 1. Sign up at https://twilio.com
# 2. Get your Account SID and Auth Token from the Twilio Console
# 3. Get an active Twilio Phone Number capable of sending SMS
# In development: If left blank, OTP is printed to the server terminal.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
