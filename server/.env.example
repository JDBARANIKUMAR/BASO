# Copy this file to .env and fill in real values. NEVER commit .env.

# Port the server listens on (hosting platforms inject their own PORT - do not hardcode it)
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS. Comma-separated for multiple (prod + preview).
# Examples:
#   development: http://localhost:5173
#   production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

# PostgreSQL (Neon) connection string - required
# Neon dashboard -> Connection Details -> pooled endpoint.
# Keep ?sslmode=require. Use DIRECT_URL for migrations if you split them later.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT secrets - required. Generate long random strings, e.g.: openssl rand -hex 48
ACCESS_TOKEN_SECRET=replace_with_long_random_string
REFRESH_TOKEN_SECRET=replace_with_long_random_string

# Optional: Twilio SMS for real OTP delivery.
# Leave empty in development: the OTP is printed in the server logs and
# returned to the UI as devCode for one-click testing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
